{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opengeomap.example/schema/ecb-provenance-1.0.json",
  "title": "Open Geo Data Map ECB provenance",
  "description": "Where one release of a European Central Bank dataset was read from: the SDMX query and the checksum of its answer, the configuration that read it, the observation statuses carried, the codes left out and, for a projection, the exercise read and what it left out.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider",
    "dataset_code",
    "licence_uri",
    "source_url",
    "source_sha256",
    "config_sha256",
    "imported_at",
    "observations_sha256",
    "series",
    "observation_statuses",
    "geography_levels",
    "excluded_codes",
    "normalisation"
  ],
  "properties": {
    "provider": { "const": "ECB" },
    "dataset_code": { "type": "string", "pattern": "^[A-Z0-9]{2,12}$" },
    "licence_uri": {
      "const": "https://www.ecb.europa.eu/stats/ecb_statistics/governance_and_quality_framework/html/usage_policy.en.html"
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://data-api\\.ecb\\.europa\\.eu/service/data/"
    },
    "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "config_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "imported_at": { "type": "string", "format": "date-time" },
    "observations_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "series": { "type": "integer", "minimum": 1 },
    "observation_statuses": {
      "type": "object",
      "propertyNames": { "enum": ["A", "E", "F"] },
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "geography_levels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared", "available_upstream"],
      "properties": {
        "declared": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 15 }
        },
        "available_upstream": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 15 }
        }
      }
    },
    "excluded_codes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "in_contract_countries"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "in_contract_countries": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2 }
        }
      }
    },
    "normalisation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geography", "missing_values", "flags", "units"],
      "properties": {
        "geography": { "type": "string", "minLength": 10 },
        "missing_values": { "type": "string", "minLength": 10 },
        "flags": { "type": "string", "minLength": 10 },
        "units": { "type": "string", "minLength": 10 }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exercise", "base_period", "observed_left_out", "beyond_horizon"],
      "properties": {
        "exercise": { "type": "string", "pattern": "^[WGSA][0-9]{2}$" },
        "base_period": { "type": "string", "pattern": "^[0-9]{4}$" },
        "observed_left_out": { "type": "integer", "minimum": 0 },
        "beyond_horizon": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
