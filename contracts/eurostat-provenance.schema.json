{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opengeomap.example/schema/eurostat-provenance-1.0.json",
  "title": "Open Geo Data Map Eurostat provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider",
    "dataset_code",
    "query_url",
    "imported_at",
    "response_sha256",
    "observations_sha256",
    "geography_levels",
    "normalisation"
  ],
  "properties": {
    "provider": { "const": "Eurostat" },
    "dataset_code": { "type": "string", "minLength": 2 },
    "query_url": { "type": "string", "format": "uri" },
    "imported_at": { "type": "string", "format": "date-time" },
    "response_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "observations_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "upstream_updated_at": { "type": ["string", "null"] },
    "upstream_label": { "type": ["string", "null"] },
    "reference_metadata_html_url": { "type": ["string", "null"], "format": "uri" },
    "reference_metadata_sdmx_url": { "type": ["string", "null"], "format": "uri" },
    "geography_levels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared", "available_upstream"],
      "properties": {
        "declared": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 15 }
        },
        "available_upstream": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 15 }
        }
      }
    },
    "normalisation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geography", "missing_values", "flags"],
      "properties": {
        "geography": { "type": "string", "minLength": 10 },
        "missing_values": { "type": "string", "minLength": 10 },
        "flags": { "type": "string", "minLength": 10 }
      }
    }
  }
}
