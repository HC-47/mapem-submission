{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opengeomap.example/schema/jrc-provenance-1.0.json",
  "title": "Open Geo Data Map JRC provenance",
  "description": "Where one release of a Joint Research Centre dataset was read from: the catalogue record and distribution that named the edition, the licence the catalogue gave it, the exact file and its checksum, and the configuration that read it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider",
    "dataset_code",
    "catalogue_record",
    "catalogue_title",
    "distribution_url",
    "licence_uri",
    "edition",
    "source_url",
    "source_sha256",
    "config_sha256",
    "imported_at",
    "observations_sha256",
    "geography_levels",
    "excluded_codes",
    "normalisation"
  ],
  "properties": {
    "provider": { "const": "JRC" },
    "dataset_code": { "type": "string", "minLength": 2 },
    "catalogue_record": { "type": "string", "format": "uri" },
    "catalogue_title": { "type": "string", "minLength": 2 },
    "catalogue_issued": { "type": ["string", "null"] },
    "catalogue_modified": { "type": ["string", "null"] },
    "distribution_url": { "type": "string", "format": "uri" },
    "licence_uri": {
      "enum": [
        "http://publications.europa.eu/resource/authority/licence/CC_BY_4_0",
        "http://publications.europa.eu/resource/authority/licence/COM_REUSE"
      ]
    },
    "edition": { "type": "string", "minLength": 1 },
    "source_url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "config_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "imported_at": { "type": "string", "format": "date-time" },
    "observations_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "geography_levels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared", "available_upstream"],
      "properties": {
        "declared": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 15 }
        },
        "available_upstream": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 15 }
        }
      }
    },
    "excluded_codes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "in_contract_countries"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "in_contract_countries": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2 }
        }
      }
    },
    "normalisation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geography", "missing_values", "flags"],
      "properties": {
        "geography": { "type": "string", "minLength": 10 },
        "missing_values": { "type": "string", "minLength": 10 },
        "flags": { "type": "string", "minLength": 10 }
      }
    }
  }
}
