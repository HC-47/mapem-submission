{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opengeomap.example/schema/managed-batch-1.0.json",
  "title": "Open Geo Data Map managed intake batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "channel",
    "provider",
    "generated_at",
    "geography",
    "source_config_sha256",
    "datasets",
    "unchanged_datasets"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "batch_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[a-z0-9._-]*[a-z0-9])?$",
      "maxLength": 160
    },
    "channel": { "const": "managed_public" },
    "provider": { "const": "Eurostat" },
    "generated_at": { "type": "string", "format": "date-time" },
    "geography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "version"],
      "properties": {
        "scheme": { "const": "NUTS" },
        "version": { "const": "2024" }
      }
    },
    "source_config_sha256": { "$ref": "#/$defs/sha256" },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/dataset" }
    },
    "unchanged_datasets": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "version",
        "previous_version",
        "path",
        "observations",
        "artifact_sha256",
        "regression"
      ],
      "properties": {
        "dataset_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "version": { "type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]*$" },
        "previous_version": { "type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]*$" },
        "path": { "type": "string", "pattern": "^managed-batches/[^/]+/datasets/[^/]+/[^/]+$" },
        "observations": { "type": "integer", "minimum": 1 },
        "artifact_sha256": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dataset.yaml", "observations.csv", "provenance.json"],
          "properties": {
            "dataset.yaml": { "$ref": "#/$defs/sha256" },
            "observations.csv": { "$ref": "#/$defs/sha256" },
            "provenance.json": { "$ref": "#/$defs/sha256" }
          }
        },
        "regression": {
          "type": "object",
          "required": [
            "previous_observations",
            "current_observations",
            "added",
            "removed",
            "changed",
            "coverage_drop",
            "removed_observation_fraction",
            "failures"
          ],
          "properties": {
            "previous_observations": { "type": "integer", "minimum": 0 },
            "current_observations": { "type": "integer", "minimum": 1 },
            "added": { "type": "integer", "minimum": 0 },
            "removed": { "type": "integer", "minimum": 0 },
            "changed": { "type": "integer", "minimum": 0 },
            "coverage_drop": { "type": "number", "minimum": 0 },
            "removed_observation_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
            "failures": { "type": "array", "items": { "type": "string" }, "maxItems": 0 }
          }
        }
      }
    }
  }
}
