{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opengeomap.example/schema/community-provenance-1.0.json",
  "title": "Open Geo Data Map community provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "source_url",
    "acquired_at",
    "source_sha256",
    "observations_sha256",
    "transformations"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "provider": { "type": "string", "minLength": 2 },
    "source_url": { "type": "string", "format": "uri" },
    "acquired_at": { "type": "string", "format": "date-time" },
    "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "observations_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_version": { "type": "string" },
    "source_updated_at": { "type": "string", "format": "date-time" },
    "transformations": {
      "type": "array",
      "items": { "type": "string", "minLength": 3 },
      "uniqueItems": true
    },
    "notes": { "type": "string" }
  }
}
